{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/types/**/*.ts"]
}
