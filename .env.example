# Explicit subscriptions permitted for live Azure reads (comma separated UUIDs).
AZURE_SUBSCRIPTIONS=
# Optional credential configuration; Azure CLI login also works locally.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Local SQLite is the default. PostgreSQL: postgresql://user:password@host/database
POLICY_DATABASE=knowledge/organization/policies.db
# Kept from the previous folder name so Docker Compose reuses existing knowledge volumes.
# Preserve a prior custom COMPOSE_PROJECT_NAME here if one was used.
COMPOSE_PROJECT_NAME=azureskills
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Required for HTTP. Generate a random secret of at least 32 characters.
MCP_AUTH_TOKEN=
# Required when binding HTTP beyond loopback. Comma-separated exact Host values.
MCP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000

